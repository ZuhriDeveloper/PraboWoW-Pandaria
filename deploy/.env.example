# Copy ke `.env` di sebelah compose file (chmod 600) lalu isi.
# File .conf dihasilkan di dalam container dari nilai-nilai ini setiap start,
# jadi kredensial tidak pernah masuk repo maupun image.

# Namespace GHCR yang di-push CI — harus huruf kecil.
GHCR_PREFIX=ghcr.io/zuhrideveloper

# Pin ke build tertentu untuk rollback: IMAGE_TAG=<commit-sha>
IMAGE_TAG=latest

# openssl rand -base64 32
DB_ROOT_PASSWORD=CHANGE_ME
DB_PASSWORD=CHANGE_ME
DB_USER=skyfire

# Yang dikirim ke client setelah autentikasi. Harus dijangkau dari internet.
# Kalau berupa domain, record DNS-nya harus "DNS only" — proxy Cloudflare
# hanya untuk HTTP dan diam-diam merusak koneksi game.
REALM_ADDRESS=wow.zuhri-dev.com
REALM_NAME=PraboWoW Pandaria
REALM_PORT=8085
AUTH_PORT=3724
REALM_ID=1

# Dump world SkyFire. Diunduh sekali ke volume prabowow_worlddb saat database
# world masih kosong, lalu diimpor core yang kemudian menerapkan
# sql/updates/world/* di atasnya.
#
# Rilis terbaru per 2026-08: sf_db_26 (21,6 MB terkompresi).
# Daftar lengkap: https://github.com/ProjectSkyfire/SkyFire_548/releases
WORLD_DB_URL=https://github.com/ProjectSkyfire/SkyFire_548/releases/download/sf_db_26/SFDB_full_548_26.002_2026_008_18_Release.zip

# Lokasi data turunan client di host (~20-25 GB, lihat tools/upload-client-data.sh).
DATA_PATH=/srv/prabowow/data

# --- Rate -------------------------------------------------------------------
# Berlaku untuk Rate.XP.Kill, Rate.XP.Quest, dan Rate.XP.Explore sekaligus.
RATE_XP=5

# Poor dan Normal (abu-abu & putih) tetap blizzlike: melipatgandakan sampah
# vendor cuma memenuhi tas tanpa menggerakkan progresi.
RATE_DROP_ITEM_COMMON=1

# Uncommon ke atas (hijau sampai Artifact). Ini mengatur loot TIDAK BERKELOMPOK
# saja — tabel loot boss dan dungeon bersifat grouped dan tidak pernah melihat
# pengali kualitas, jadi menaikkan ini TIDAK membuat boss drop lebih banyak.
# Itu butuh penyuntingan loot template di database.
RATE_DROP_ITEM_QUALITY=50

# Biarkan 1. Flag rate diteruskan ke template yang direferensikan, jadi item di
# dalamnya sudah dapat pengali kualitasnya sendiri; menaikkan ini melipatkan dua kali.
RATE_DROP_ITEM_REFERENCED=1

# Gold dari kill. Catatan: SkyFire 5.4.8 TIDAK punya key setara
# Rate.Quest.Money.Reward seperti TrinityCore Cataclysm, jadi gold dari quest
# tidak bisa di-skala lewat config.
RATE_DROP_MONEY=5

RATE_HONOR=1
RATE_REPUTATION=1

# --- Batas resource ---------------------------------------------------------
# Turunkan ini lebih dulu kalau VPS sempit: world server butuh ~3-5 GB dengan
# mmaps termuat, MySQL tetap jalan mulai dari 512M buffer pool (lebih lambat,
# bukan rusak).
WORLD_MEM_LIMIT=6g
AUTH_MEM_LIMIT=512m
DB_BUFFER_POOL=2G
