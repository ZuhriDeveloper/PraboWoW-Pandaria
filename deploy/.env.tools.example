# Copy ke deploy/.env.tools lalu isi. Hanya untuk ekstraksi data client di PC
# lokal — tidak ada hubungannya dengan .env stack server di VPS.

GHCR_PREFIX=ghcr.io/zuhrideveloper
TOOLS_IMAGE_TAG=latest

# Folder ROOT client (yang berisi Wow.exe dan folder Data). Pakai garis miring
# depan, bukan backslash.
CLIENT_PATH=C:/Games/World of Warcraft 5.4.8

# Folder .ssh milikmu di host, berisi private key yang sudah bisa SSH ke VPS.
SSH_DIR=C:/Users/achma/.ssh

# Tujuan unggah.
VPS_SSH=root@145.79.10.227
VPS_DATA_PATH=/srv/prabowow/data

# 0 = pakai semua core CPU. Turunkan (mis. 4) kalau PC masih dipakai kerja
# selama mmaps berjalan berjam-jam.
MMAP_THREADS=0
